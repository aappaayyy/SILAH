APP_NAME="Sistem Layanan Akses Hotspot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=#nama database
DB_USERNAME=#username database
DB_PASSWORD=#password database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ROUTEROS_HOST=#domain atau ip mikrotik
ROUTEROS_USER=#username mikrotik
ROUTEROS_PASS=#password routeros
ROUTEROS_PORT=#port routeros, default 8728
ROUTEROS_SSL=true #set ke false jika tidak menggunakan SSL
ROUTEROS_TIMEOUT=3

# SSL Configurations
#hapus tanda # di depan jika menggunakan SSL, dan sesuaikan dengan konfigurasi SSL yang digunakan
#ROUTEROS_SSL_CIPHER=DEFAULT
#ROUTEROS_SSL_VERIFY_PEER=true
#ROUTEROS_SSL_VERIFY_PEER_NAME=true
#ROUTEROS_SSL_ALLOW_SELF_SIGNED=false

ROUTEROS_DEFAULT_PROFILE=#default profile hotspot, misal Mahasiswa

#Whatsapp Gateway Configurations
WA_URL=http://127.0.0.1:3000
WA_SECRET=#secret key whatsapp disamakan dengan konfigurasi di whatsapp gateway